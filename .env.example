REVIEW_SECRET_KEY=replace-with-a-random-32-byte-or-longer-value

# Server-only Clinical Insights integration. Never use NEXT_PUBLIC_* variables.
COLLABVET_API_BASE_URL=https://collabvet-staging-api.onrender.com
COLLABVET_REVIEW_CLIENT_ID=collabvet-review
COLLABVET_REVIEW_CLIENT_SECRET=copy-from-Render-REVIEW_API_CLIENT_SECRET

# Cases are read directly from this private repository checkout's cases/ directory.
REVIEW_CLINICAL_DATA_ROOT=C:\Projects\collabvet-clinical-data

# Defaults below are relative to this repository; override only when needed.
# REVIEW_SOURCE_ROOT=C:\path\to\PII-removed-patient-folders
# REVIEW_OUTPUT_ROOT=C:\Projects\collabvet-review-app\data\review_app\approved
# REVIEW_TEACHER_ROOT=C:\Projects\collabvet-review-app\data\teacher
# REVIEW_INSTANCE_ROOT=C:\Projects\collabvet-review-app\data\review_app
# REVIEW_CONFIG_ROOT=C:\Projects\collabvet-review-app\config

REVIEW_BIND_HOST=127.0.0.1
REVIEW_PORT=5055
REVIEW_ALLOW_LAN_BIND=false
REVIEW_SECURE_COOKIES=false
